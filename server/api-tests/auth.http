### Login and current-user checks

### Register fixed login test user
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "fullName": "Login Test Student",
  "email": "login-test-student@example.com",
  "password": "Password123",
  "role": "student"
}

### Login fixed test user
# @name loginFixedTestUser
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "login-test-student@example.com",
  "password": "Password123"
}

> {% client.global.set("authToken", response.body.token); %}

### Current user with valid token
GET http://localhost:4000/api/auth/me
Authorization: Bearer {{authToken}}

### Reject missing token
GET http://localhost:4000/api/auth/me

### Reject invalid token
GET http://localhost:4000/api/auth/me
Authorization: Bearer invalid-token

### Reject wrong password
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "login-test-student@example.com",
  "password": "WrongPassword123"
}

### Reject unknown email
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "unknown-login-user@example.com",
  "password": "Password123"
}

### RBAC checks

### RBAC setup: create fixed admin in database console once
# Public registration intentionally rejects admin users.
# Run this SQL in console.sql before testing the successful admin case:
#
# INSERT INTO users (id, "fullName", email, "passwordHash", role, status)
# VALUES (
#   '11111111-1111-4111-8111-111111111111',
#   'RBAC Admin',
#   'rbac-admin@example.com',
#   '$2b$12$aM18pZLvzBgVV0yvZEvVS.J4HwfuIJqGaWUYkr.DXpJx1uuF4WLnu',
#   'admin',
#   'active'
# )
# ON CONFLICT (email) DO UPDATE
# SET
#   "passwordHash" = EXCLUDED."passwordHash",
#   role = EXCLUDED.role,
#   status = EXCLUDED.status;

### Login fixed RBAC admin
# @name loginRbacAdmin
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "rbac-admin@example.com",
  "password": "Password123"
}

> {% client.global.set("adminAuthToken", response.body.token); %}

### RBAC admin check rejects missing token
GET http://localhost:4000/api/auth/admin-check

### RBAC admin check rejects invalid token
GET http://localhost:4000/api/auth/admin-check
Authorization: Bearer invalid-token

### RBAC admin check rejects student token
# Run "Login fixed test user" first so authToken contains a student token.
GET http://localhost:4000/api/auth/admin-check
Authorization: Bearer {{authToken}}

### RBAC admin check allows admin token
# Run "Login fixed RBAC admin" first so adminAuthToken contains an admin token.
GET http://localhost:4000/api/auth/admin-check
Authorization: Bearer {{adminAuthToken}}
