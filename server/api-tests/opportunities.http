# Opportunity checks

# Setup data used by the rest of this file.
# Fixtures

### Register mentor
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "fullName": "Opportunity Test Mentor",
  "email": "opportunity-mentor-{{$timestamp}}@example.com",
  "password": "Password123",
  "role": "mentor"
}

> {% client.global.set("opportunityMentorToken", response.body.token); %}

### Register student
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "fullName": "Opportunity Test Student",
  "email": "opportunity-student-{{$timestamp}}@example.com",
  "password": "Password123",
  "role": "student"
}

> {% client.global.set("opportunityStudentToken", response.body.token); %}

# Admin must already exist from the RBAC setup SQL in rbac.http.
### Login admin
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "rbac-admin@example.com",
  "password": "Password123"
}

> {% client.global.set("opportunityAdminToken", response.body.token); %}

### Create base opportunity
POST http://localhost:4000/api/opportunities
Content-Type: application/json
Authorization: Bearer {{opportunityMentorToken}}

{
  "title": "React Internship",
  "description": "Build frontend features with React, TypeScript, and backend APIs.",
  "type": "internship",
  "capacity": 2,
  "deadline": "2027-08-10T23:59:00.000Z",
  "startDate": "2027-08-20T09:00:00.000Z",
  "imageUrl": "",
  "attachmentUrl": ""
}

> {% client.global.set("opportunityId", response.body.opportunity.id); %}

# Create

### Reject without token
POST http://localhost:4000/api/opportunities
Content-Type: application/json

{
  "title": "Unauthorized Internship",
  "description": "This request should fail because it does not send an auth token.",
  "type": "internship",
  "capacity": 2,
  "deadline": "2027-08-10T23:59:00.000Z"
}

### Reject as student
POST http://localhost:4000/api/opportunities
Content-Type: application/json
Authorization: Bearer {{opportunityStudentToken}}

{
  "title": "Student Internship",
  "description": "This request should fail because students cannot create opportunities.",
  "type": "internship",
  "capacity": 2,
  "deadline": "2027-08-10T23:59:00.000Z"
}

### Reject with past deadline
POST http://localhost:4000/api/opportunities
Content-Type: application/json
Authorization: Bearer {{opportunityMentorToken}}

{
  "title": "Expired Internship",
  "description": "This request should fail because the deadline is already in the past.",
  "type": "internship",
  "capacity": 2,
  "deadline": "2025-08-10T23:59:00.000Z"
}

# Mentor management

### List mine
GET http://localhost:4000/api/opportunities/mine
Authorization: Bearer {{opportunityMentorToken}}

### Reject list mine without token
GET http://localhost:4000/api/opportunities/mine

### Reject list mine as student
GET http://localhost:4000/api/opportunities/mine
Authorization: Bearer {{opportunityStudentToken}}

### Update own opportunity
PATCH http://localhost:4000/api/opportunities/{{opportunityId}}
Content-Type: application/json
Authorization: Bearer {{opportunityMentorToken}}

{
  "title": "Updated React Internship",
  "capacity": 3,
  "status": "pending_approval"
}

### Reject update without token
PATCH http://localhost:4000/api/opportunities/{{opportunityId}}
Content-Type: application/json

{
  "title": "Unauthorized Update"
}

### Reject update as student
PATCH http://localhost:4000/api/opportunities/{{opportunityId}}
Content-Type: application/json
Authorization: Bearer {{opportunityStudentToken}}

{
  "title": "Student Update"
}

### Reject update with past deadline
PATCH http://localhost:4000/api/opportunities/{{opportunityId}}
Content-Type: application/json
Authorization: Bearer {{opportunityMentorToken}}

{
  "deadline": "2025-08-10T23:59:00.000Z"
}

### Reject update for unknown opportunity
PATCH http://localhost:4000/api/opportunities/11111111-1111-4111-8111-111111111111
Content-Type: application/json
Authorization: Bearer {{opportunityMentorToken}}

{
  "title": "Missing Opportunity"
}

# Public browsing

### List published
GET http://localhost:4000/api/opportunities

# This opportunity starts as pending_approval, so public detail should return 404.
### Reject unpublished detail
GET http://localhost:4000/api/opportunities/{{opportunityId}}

### Reject unknown detail
GET http://localhost:4000/api/opportunities/11111111-1111-4111-8111-111111111111

# Admin approval

### Reject approve without token
POST http://localhost:4000/api/opportunities/{{opportunityId}}/approve

### Reject approve as student
POST http://localhost:4000/api/opportunities/{{opportunityId}}/approve
Authorization: Bearer {{opportunityStudentToken}}

### Approve
POST http://localhost:4000/api/opportunities/{{opportunityId}}/approve
Authorization: Bearer {{opportunityAdminToken}}

### List published after approval
GET http://localhost:4000/api/opportunities

### View published detail
GET http://localhost:4000/api/opportunities/{{opportunityId}}

### Reject
POST http://localhost:4000/api/opportunities/{{opportunityId}}/reject
Authorization: Bearer {{opportunityAdminToken}}

### Reject detail after rejection
GET http://localhost:4000/api/opportunities/{{opportunityId}}
