# Application checks

# Fixtures

### Register application mentor
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "fullName": "Application Test Mentor",
  "email": "application-mentor-{{$timestamp}}@example.com",
  "password": "Password123",
  "role": "mentor"
}

> {% client.global.set("applicationMentorToken", response.body.token); %}

### Register application student
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "fullName": "Application Test Student",
  "email": "application-student-{{$timestamp}}@example.com",
  "password": "Password123",
  "role": "student"
}

> {% client.global.set("applicationStudentToken", response.body.token); %}

### Register other student
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "fullName": "Other Application Student",
  "email": "other-application-student-{{$timestamp}}@example.com",
  "password": "Password123",
  "role": "student"
}

> {% client.global.set("otherApplicationStudentToken", response.body.token); %}

# Admin must already exist from the RBAC setup SQL in rbac.http.
### Login admin
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "rbac-admin@example.com",
  "password": "Password123"
}

> {% client.global.set("applicationAdminToken", response.body.token); %}

### Create opportunity
POST http://localhost:4000/api/opportunities
Content-Type: application/json
Authorization: Bearer {{applicationMentorToken}}

{
  "title": "Application Workflow Internship",
  "description": "Build and test the student application workflow for published opportunities.",
  "type": "internship",
  "capacity": 1,
  "deadline": "2027-08-10T23:59:00.000Z",
  "startDate": "2027-08-20T09:00:00.000Z",
  "imageUrl": "",
  "attachmentUrl": ""
}

> {% client.global.set("applicationOpportunityId", response.body.opportunity.id); %}

### Publish opportunity
POST http://localhost:4000/api/opportunities/{{applicationOpportunityId}}/approve
Authorization: Bearer {{applicationAdminToken}}

# Apply

### Apply as student
POST http://localhost:4000/api/opportunities/{{applicationOpportunityId}}/apply
Content-Type: application/json
Authorization: Bearer {{applicationStudentToken}}

{
  "coverNote": "I am interested in this opportunity because I want to practice full-stack development."
}

> {% client.global.set("applicationId", response.body.application.id); %}

# Student management

### List my applications
GET http://localhost:4000/api/applications?page=1&limit=3
Authorization: Bearer {{applicationStudentToken}}

### Reject list invalid page
GET http://localhost:4000/api/applications?page=0
Authorization: Bearer {{applicationStudentToken}}

### Reject list invalid limit
GET http://localhost:4000/api/applications?limit=100
Authorization: Bearer {{applicationStudentToken}}

### Reject list without token
GET http://localhost:4000/api/applications

### Reject duplicate application
POST http://localhost:4000/api/opportunities/{{applicationOpportunityId}}/apply
Content-Type: application/json
Authorization: Bearer {{applicationStudentToken}}

{
  "coverNote": "Trying to apply again."
}

### List applications as mentor
GET http://localhost:4000/api/applications?page=1&limit=3
Authorization: Bearer {{applicationMentorToken}}

### List applications as admin
GET http://localhost:4000/api/applications?page=1&limit=3
Authorization: Bearer {{applicationAdminToken}}

### Reject status update as student
PATCH http://localhost:4000/api/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{applicationStudentToken}}

{
  "status": "shortlisted",
  "mentorNote": "Student should not update status."
}

### Update status as mentor
PATCH http://localhost:4000/api/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{applicationMentorToken}}

{
  "status": "shortlisted",
  "mentorNote": "Strong application."
}

### Update status as admin
PATCH http://localhost:4000/api/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{applicationAdminToken}}

{
  "status": "waitlisted",
  "mentorNote": "Admin review update."
}

### Apply as other student
POST http://localhost:4000/api/opportunities/{{applicationOpportunityId}}/apply
Content-Type: application/json
Authorization: Bearer {{otherApplicationStudentToken}}

{
  "coverNote": "I am also interested in this opportunity."
}

> {% client.global.set("otherApplicationId", response.body.application.id); %}

### Select first application
PATCH http://localhost:4000/api/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{applicationMentorToken}}

{
  "status": "selected",
  "mentorNote": "Selected for the available slot."
}

### Reject selection after capacity reached
PATCH http://localhost:4000/api/applications/{{otherApplicationId}}/status
Content-Type: application/json
Authorization: Bearer {{applicationMentorToken}}

{
  "status": "selected",
  "mentorNote": "This should fail because capacity is full."
}

### Reject invalid status
PATCH http://localhost:4000/api/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{applicationMentorToken}}

{
  "status": "withdrawn"
}

### Reject status update for unknown application
PATCH http://localhost:4000/api/applications/11111111-1111-4111-8111-111111111111/status
Content-Type: application/json
Authorization: Bearer {{applicationMentorToken}}

{
  "status": "shortlisted"
}

### Withdraw my application
POST http://localhost:4000/api/applications/{{applicationId}}/withdraw
Authorization: Bearer {{applicationStudentToken}}

### Reject withdraw without token
POST http://localhost:4000/api/applications/{{applicationId}}/withdraw

### Reject withdraw as other student
POST http://localhost:4000/api/applications/{{applicationId}}/withdraw
Authorization: Bearer {{otherApplicationStudentToken}}

### Reject withdraw unknown application
POST http://localhost:4000/api/applications/11111111-1111-4111-8111-111111111111/withdraw
Authorization: Bearer {{applicationStudentToken}}

### Reject apply without token
POST http://localhost:4000/api/opportunities/{{applicationOpportunityId}}/apply
Content-Type: application/json

{
  "coverNote": "Missing token."
}

### Reject apply as mentor
POST http://localhost:4000/api/opportunities/{{applicationOpportunityId}}/apply
Content-Type: application/json
Authorization: Bearer {{applicationMentorToken}}

{
  "coverNote": "Mentor should not apply."
}

### Reject apply to unknown opportunity
POST http://localhost:4000/api/opportunities/11111111-1111-4111-8111-111111111111/apply
Content-Type: application/json
Authorization: Bearer {{applicationStudentToken}}

{
  "coverNote": "Unknown opportunity."
}
